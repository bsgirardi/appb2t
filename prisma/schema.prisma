generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  OPERATOR
}
enum Technology {
  FDM
  RESIN
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role @default(OPERATOR)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  settings CalculationSettings[]
}
model Session {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId])
  @@index([expiresAt])
}
model LoginAttempt {
  key String @id
  attempts Int @default(0)
  windowStart DateTime @default(now())
}
model Material {
  products Product[]
  id String @id @default(cuid())
  name String
  technology Technology
  price Decimal @db.Decimal(18, 6)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Printer {
  products Product[]
  id String @id @default(cuid())
  name String
  technology Technology
  acquisitionCost Decimal @db.Decimal(18, 6)
  amortizationMonths Int
  daysPerMonth Int
  hoursPerDay Decimal @db.Decimal(18, 6)
  watts Decimal @db.Decimal(18, 6)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CalculationSettings {
  id Int @id @default(1)
  energyRate Decimal @db.Decimal(18, 6)
  maintenancePercent Decimal @db.Decimal(18, 6)
  failurePercent Decimal @db.Decimal(18, 6)
  finishingPercent Decimal @db.Decimal(18, 6)
  fixation Decimal @db.Decimal(18, 6)
  markupPercent Decimal @db.Decimal(18, 6)
  version Int @default(1)
  updatedAt DateTime @updatedAt
  updatedById String
  updatedBy User @relation(fields: [updatedById], references: [id])
}
model Product {
  collections CollectionProduct[]
  id String @id @default(cuid())
  name String
  description String
  paymentTerms String
  active Boolean @default(true)
  calculation Json
  price Decimal @db.Decimal(18, 2)
  materialId String?
  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  printerId String?
  printer Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images ProductImage[]
  @@index([active, name])
}
model Collection {
  id String @id @default(cuid())
  name String
  description String
  active Boolean @default(true)
  position Int @default(0)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products CollectionProduct[]
  image CollectionImage?
}
model CollectionProduct {
  collectionId String
  productId String
  collection Collection @relation(fields:[collectionId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@id([collectionId,productId])
  @@index([productId])
}
model CollectionImage {
  collectionId String @id
  collection Collection @relation(fields:[collectionId],references:[id],onDelete:Cascade)
  bytes Bytes
  mimeType String
}
model CompanyAppearance {
 id Int @id @default(1)
 name String
 shortName String
 slogan String
 email String
 phone String
 address String
 footer String
 lightPrimary String
 lightAccent String
 darkPrimary String
 darkAccent String
 version Int @default(1)
 updatedAt DateTime @updatedAt
 updatedById String
 logo CompanyLogo?
}
model CompanyLogo {
 cacheKey String @default(cuid())
 appearanceId Int @id
 appearance CompanyAppearance @relation(fields:[appearanceId],references:[id],onDelete:Cascade)
 bytes Bytes
 mimeType String
}
enum CustomerType {
 PERSON
 COMPANY
}
model Customer {
 id String @id @default(cuid())
 name String
 type CustomerType
 document String @default("")
 email String @default("")
 phone String @default("")
 address String @default("")
 notes String @default("")
 active Boolean @default(true)
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([active,name])
}
model ProductImage {
  id String @id @default(cuid())
  productId String
  position Int
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  bytes Bytes
  mimeType String
  @@unique([productId, position])
}
