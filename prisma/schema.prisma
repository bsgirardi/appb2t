generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  OPERATOR
}
enum Technology {
  FDM
  RESIN
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role @default(OPERATOR)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  settings CalculationSettings[]
}
model Session {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId])
  @@index([expiresAt])
}
model LoginAttempt {
  key String @id
  attempts Int @default(0)
  windowStart DateTime @default(now())
}
model Material {
 stockItem StockItem?
  products Product[]
  id String @id @default(cuid())
  name String
  technology Technology
  price Decimal @db.Decimal(18, 6)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Printer {
  products Product[]
  id String @id @default(cuid())
  name String
  technology Technology
  acquisitionCost Decimal @db.Decimal(18, 6)
  amortizationMonths Int
  daysPerMonth Int
  hoursPerDay Decimal @db.Decimal(18, 6)
  watts Decimal @db.Decimal(18, 6)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CalculationSettings {
  id Int @id @default(1)
  energyRate Decimal @db.Decimal(18, 6)
  maintenancePercent Decimal @db.Decimal(18, 6)
  failurePercent Decimal @db.Decimal(18, 6)
  finishingPercent Decimal @db.Decimal(18, 6)
  fixation Decimal @db.Decimal(18, 6)
  markupPercent Decimal @db.Decimal(18, 6)
  version Int @default(1)
  updatedAt DateTime @updatedAt
  updatedById String
  updatedBy User @relation(fields: [updatedById], references: [id])
}
model Product {
  sku String? @unique
  shortDescription String @default("")
  specifications String @default("")
  colors String[] @default([])
  sizes String[] @default([])
  availability String @default("CONSULT")
  leadTimeDays Int?
  seoTitle String @default("")
  seoDescription String @default("")
  collections CollectionProduct[]
  id String @id @default(cuid())
  name String
  description String
  paymentTerms String
  active Boolean @default(true)
  calculation Json
  price Decimal @db.Decimal(18, 2)
  materialId String?
  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  printerId String?
  printer Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images ProductImage[]
  @@index([active, name])
}
model Collection {
  id String @id @default(cuid())
  name String
  description String
  active Boolean @default(true)
  position Int @default(0)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products CollectionProduct[]
  image CollectionImage?
}
model CollectionProduct {
  collectionId String
  productId String
  collection Collection @relation(fields:[collectionId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@id([collectionId,productId])
  @@index([productId])
}
model CollectionImage {
  collectionId String @id
  collection Collection @relation(fields:[collectionId],references:[id],onDelete:Cascade)
  bytes Bytes
  mimeType String
}
model CompanyAppearance {
 storefront Json @default("{}")
 id Int @id @default(1)
 name String
 shortName String
 slogan String
 email String
 phone String
 address String
 footer String
 lightPrimary String
 lightAccent String
 darkPrimary String
 darkAccent String
 version Int @default(1)
 updatedAt DateTime @updatedAt
 updatedById String
 logo CompanyLogo?
}
model CompanyLogo {
 cacheKey String @default(cuid())
 appearanceId Int @id
 appearance CompanyAppearance @relation(fields:[appearanceId],references:[id],onDelete:Cascade)
 bytes Bytes
 mimeType String
}
enum CustomerType {
 PERSON
 COMPANY
}
model Customer {
 sales Sale[]
 entries FinancialEntry[]
 quotes Quote[]
 id String @id @default(cuid())
 name String
 type CustomerType
 document String @default("")
 email String @default("")
 phone String @default("")
 address String @default("")
 notes String @default("")
 active Boolean @default(true)
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([active,name])
}
enum QuoteStatus {
 RASCUNHO
 ENVIADO
 APROVADO
 REJEITADO
 CONVERTIDO
}
model Quote {
 costRevisionId String?
 sale Sale?
 id String @id @default(cuid())
 sequence Int @unique @default(autoincrement())
 status QuoteStatus @default(RASCUNHO)
 version Int @default(1)
 customerId String?
 customer Customer? @relation(fields:[customerId],references:[id],onDelete:Restrict)
 input Json
 snapshot Json?
 totals Json?
 validUntil DateTime? @db.Date
 items QuoteItem[]
 events CommerceEvent[]
 logo DocumentLogo?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status,createdAt])
}
model QuoteItem {
 lineKey String?
 id String @id @default(cuid())
 quoteId String
 quote Quote @relation(fields:[quoteId],references:[id],onDelete:Cascade)
 position Int
 productId String?
 description String
 quantity Int
 unitPrice Decimal @db.Decimal(18,2)
 @@unique([quoteId,position])
 @@unique([quoteId,lineKey])
}
model CommerceEvent {
 saleId String?
 sale Sale? @relation(fields:[saleId],references:[id],onDelete:Restrict)
 id String @id @default(cuid())
 quoteId String?
 quote Quote? @relation(fields:[quoteId],references:[id],onDelete:Restrict)
 action String
 reason String @default("")
 actorId String
 actorName String
 createdAt DateTime @default(now())
 @@index([quoteId,createdAt])
}
model DocumentLogo {
 saleId String? @unique
 sale Sale? @relation(fields:[saleId],references:[id],onDelete:Restrict)
 id String @id @default(cuid())
 quoteId String? @unique
 quote Quote? @relation(fields:[quoteId],references:[id],onDelete:Restrict)
 bytes Bytes
 mimeType String
}
enum SaleStatus {
 RASCUNHO
 CONFIRMADA
 EM_PRODUCAO
 PRONTA
 ENTREGUE
 CANCELADA
}
enum FinancialEntryKind {
 RECEIVABLE
 PAYABLE
}
model Sale {
 stockReservations StockReservation[]
 costRevisionId String?
 id String @id @default(cuid())
 sequence Int @unique @default(autoincrement())
 quoteId String? @unique
 quote Quote? @relation(fields:[quoteId],references:[id],onDelete:Restrict)
 customerId String
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict)
 status SaleStatus @default(RASCUNHO)
 version Int @default(1)
 document Json
 totals Json
 snapshot Json?
 expectedDeliveryDate DateTime? @db.Date
 operationalNotes String @default("")
 items SaleItem[]
 installments SaleInstallment[]
 events CommerceEvent[]
 logo DocumentLogo?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status,createdAt])
}
model SaleItem {
 lineKey String?
 id String @id @default(cuid())
 saleId String
 sale Sale @relation(fields:[saleId],references:[id],onDelete:Cascade)
 position Int
 productId String?
 description String
 quantity Int
 unitPrice Decimal @db.Decimal(18,2)
 @@unique([saleId,position])
 @@unique([saleId,lineKey])
}
model SaleInstallment {
 id String @id @default(cuid())
 saleId String
 sale Sale @relation(fields:[saleId],references:[id],onDelete:Restrict)
 number Int
 amount Decimal @db.Decimal(18,2)
 dueDate DateTime @db.Date
 entry FinancialEntry?
 @@unique([saleId,number])
}
model FinancialEntry {
 receiptLink ReceiptFinancialLink?
 categoryId String?
 category FinancialCategory? @relation(fields:[categoryId],references:[id],onDelete:Restrict)
 groupId String?
 settlements Settlement[]
 id String @id @default(cuid())
 kind FinancialEntryKind
 amount Decimal @db.Decimal(18,2)
 dueDate DateTime @db.Date
 description String
 counterparty String
 customerId String?
 customer Customer? @relation(fields:[customerId],references:[id],onDelete:Restrict)
 saleInstallmentId String? @unique
 saleInstallment SaleInstallment? @relation(fields:[saleInstallmentId],references:[id],onDelete:Restrict)
 canceledAt DateTime?
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([kind,dueDate])
}
model CommercialOperation {
 key String @id
 type String
 payloadHash String
 result Json
 createdAt DateTime @default(now())
}
enum AccountType {
 CASH
 BANK
 OTHER
}
enum CategoryKind {
 REVENUE
 EXPENSE
}
enum MovementKind {
 RECEIPT
 PAYMENT
 TRANSFER
 ADJUSTMENT
 REVERSAL
}
enum PaymentMethod {
 PIX
 CASH
 CARD
 BOLETO
 TRANSFER
 OTHER
}
model FinancialAccount {
 id String @id @default(cuid())
 name String
 type AccountType
 openingBalance Decimal @db.Decimal(18,2)
 openingDate DateTime @db.Date
 active Boolean @default(true)
 version Int @default(1)
 movements CashMovement[]
 settlements Settlement[]
 outgoingTransfers FinancialTransfer[] @relation("TransferFrom")
 incomingTransfers FinancialTransfer[] @relation("TransferTo")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model FinancialCategory {
 id String @id @default(cuid())
 name String
 kind CategoryKind
 active Boolean @default(true)
 version Int @default(1)
 systemCode String? @unique
 entries FinancialEntry[]
 movements CashMovement[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Settlement {
 id String @id @default(cuid())
 entryId String
 entry FinancialEntry @relation(fields:[entryId],references:[id],onDelete:Restrict)
 accountId String
 account FinancialAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
 amount Decimal @db.Decimal(18,2)
 method PaymentMethod
 effectiveDate DateTime @db.Date
 notes String @default("")
 movement CashMovement?
 createdAt DateTime @default(now())
 @@index([entryId])
}
model CashMovement {
 id String @id @default(cuid())
 accountId String
 account FinancialAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
 categoryId String?
 category FinancialCategory? @relation(fields:[categoryId],references:[id],onDelete:Restrict)
 amount Decimal @db.Decimal(18,2)
 effectiveDate DateTime @db.Date
 kind MovementKind
 description String
 actorId String
 actorName String
 settlementId String? @unique
 settlement Settlement? @relation(fields:[settlementId],references:[id],onDelete:Restrict)
 transferId String?
 transfer FinancialTransfer? @relation(fields:[transferId],references:[id],onDelete:Restrict)
 reversalOfId String? @unique
 reversalOf CashMovement? @relation("MovementReversal",fields:[reversalOfId],references:[id],onDelete:Restrict)
 reversedBy CashMovement? @relation("MovementReversal")
 createdAt DateTime @default(now())
 @@index([accountId,effectiveDate])
 @@index([categoryId,effectiveDate])
}
model FinancialTransfer {
 id String @id @default(cuid())
 fromAccountId String
 fromAccount FinancialAccount @relation("TransferFrom",fields:[fromAccountId],references:[id],onDelete:Restrict)
 toAccountId String
 toAccount FinancialAccount @relation("TransferTo",fields:[toAccountId],references:[id],onDelete:Restrict)
 amount Decimal @db.Decimal(18,2)
 effectiveDate DateTime @db.Date
 description String
 movements CashMovement[]
 createdAt DateTime @default(now())
}
model FinancialAuditEvent {
 id String @id @default(cuid())
 entityType String
 entityId String
 action String
 reason String @default("")
 changes Json
 actorId String
 actorName String
 createdAt DateTime @default(now())
 @@index([entityType,entityId,createdAt])
}
model FinanceCommand {
 key String @id
 type String
 payloadHash String
 result Json
 actorId String
 createdAt DateTime @default(now())
}
model ProductImage {
  id String @id @default(cuid())
  productId String
  position Int
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  bytes Bytes
  mimeType String
  @@unique([productId, position])
}

model PricingSettings {
  id Int @id @default(1)
  values Json
  version Int @default(1)
  updatedAt DateTime @updatedAt
  updatedById String
}
model PricingChannel {
  id String @id @default(cuid())
  name String
  fees Json
  fixedCost Decimal @db.Decimal(18,6)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PricingExtra {
 stockItem StockItem?
  id String @id @default(cuid())
  name String
  unitCost Decimal @db.Decimal(18,6)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PricingSnapshot {
  id String @id @default(cuid())
  input Json
  result Json
  actorId String
  actorName String
  createdAt DateTime @default(now())
  operationKey String
  requestHash String
  @@unique([actorId,operationKey])
}
model ProductCalculationRevision {
  id String @id @default(cuid())
  productId String
  productVersion Int
  calculation Json
  actorId String
  actorName String
  createdAt DateTime @default(now())
  @@unique([productId,productVersion])
}
model DocumentCostRevision {
  id String @id @default(cuid())
  quoteId String?
  saleId String?
  revision Int
  bindings Json
  frozenAt DateTime?
  sourceRevisionId String?
  createdAt DateTime @default(now())
  @@unique([quoteId,revision])
  @@unique([saleId,revision])
}

model StockItem {
  id             String                   @id @default(cuid())
  name           String
  unit           String
  materialId     String?                  @unique
  material       Material?                @relation(fields: [materialId], references: [id], onDelete: Restrict)
  extraId        String?                  @unique
  extra          PricingExtra?            @relation(fields: [extraId], references: [id], onDelete: Restrict)
  method         String
  manualUnitCost Decimal?                 @db.Decimal(24, 6)
  inventoriedAt  DateTime?
  active         Boolean                  @default(true)
  version        Int                      @default(1)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  identities     StockIdentity[]
  movements      StockMovement[]
  reservations   StockReservation[]
  receipts       PurchaseReceiptLine[]
  valuations     StockValuationRevision[]
}

model StockIdentity {
  id          String                    @id @default(cuid())
  itemId      String
  item        StockItem                 @relation(fields: [itemId], references: [id], onDelete: Restrict)
  label       String
  createdAt   DateTime                  @default(now())
  allocations StockMovementAllocation[]

  @@unique([itemId, label])
  @@unique([id, itemId])
}

model StockMovement {
  id             String                    @id @default(cuid())
  sequence       Int                       @unique @default(autoincrement())
  itemId         String
  item           StockItem                 @relation(fields: [itemId], references: [id], onDelete: Restrict)
  kind           String
  quantity       Decimal                   @db.Decimal(24, 6)
  method         String
  manualUnitCost Decimal?                  @db.Decimal(24, 6)
  confirmedValue Decimal?                  @db.Decimal(24, 6)
  sourceId       String?
  source         StockMovement?            @relation("StockCorrection", fields: [sourceId], references: [id], onDelete: Restrict)
  corrections    StockMovement[]           @relation("StockCorrection")
  actorId        String
  reason         String                    @default("")
  effectiveDate  DateTime                  @db.Date
  createdAt      DateTime                  @default(now())
  receiptLineId  String?                   @unique
  receiptLine    PurchaseReceiptLine?      @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  allocations    StockMovementAllocation[]

  @@unique([id, itemId])
  @@index([itemId, sequence])
}

model StockMovementAllocation {
  id         String         @id @default(cuid())
  movementId String
  movement   StockMovement  @relation(fields: [movementId], references: [id], onDelete: Restrict)
  identityId String?
  identity   StockIdentity? @relation(fields: [identityId], references: [id], onDelete: Restrict)
  quantity   Decimal        @db.Decimal(24, 6)

  @@index([movementId])
}

model StockReservation {
  id        String                  @id @default(cuid())
  itemId    String
  item      StockItem               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  saleId    String
  sale      Sale                    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  lineKey   String
  version   Int                     @default(1)
  createdAt DateTime                @default(now())
  events    StockReservationEvent[]

  @@index([saleId, lineKey])
}

model StockReservationEvent {
  id            String           @id @default(cuid())
  reservationId String
  reservation   StockReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  kind          String
  quantity      Decimal          @db.Decimal(24, 6)
  movementId    String?
  actorId       String
  reason        String           @default("")
  createdAt     DateTime         @default(now())

  @@index([reservationId])
}

model StockValuationRevision {
  id          String                     @id @default(cuid())
  itemId      String
  item        StockItem                  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  factsHash   String
  result      Json
  createdAt   DateTime                   @default(now())
  allocations StockValuationAllocation[]

  @@unique([itemId, factsHash])
}

model StockValuationAllocation {
  id          String                 @id @default(cuid())
  revisionId  String
  revision    StockValuationRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  sourceId    String
  targetId    String
  quantity    Decimal                @db.Decimal(24, 6)
  value       Decimal?               @db.Decimal(24, 6)
  provisional Boolean

  @@index([revisionId])
}

model PurchaseReceipt {
  id            String                 @id @default(cuid())
  supplier      String
  document      String                 @default("")
  status        String                 @default("PENDING")
  actorId       String
  confirmedById String?
  confirmedAt   DateTime?
  canceledAt    DateTime?
  effectiveDate DateTime               @db.Date
  total         Decimal?               @db.Decimal(18, 2)
  version       Int                    @default(1)
  createdAt     DateTime               @default(now())
  lines         PurchaseReceiptLine[]
  entries       ReceiptFinancialLink[]
}

model PurchaseReceiptLine {
  id             String          @id @default(cuid())
  receiptId      String
  receipt        PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  itemId         String
  item           StockItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity       Decimal         @db.Decimal(24, 6)
  confirmedValue Decimal?        @db.Decimal(18, 2)
  movement       StockMovement?

  @@index([receiptId])
}

model ReceiptFinancialLink {
  id        String          @id @default(cuid())
  receiptId String
  receipt   PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  entryId   String          @unique
  entry     FinancialEntry  @relation(fields: [entryId], references: [id], onDelete: Restrict)
  createdAt DateTime        @default(now())

  @@index([receiptId])
}

model StockCommand {
  key         String   @id
  type        String
  payloadHash String
  result      Json
  actorId     String
  createdAt   DateTime @default(now())
}

