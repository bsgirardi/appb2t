# Exemplo para instalação nova no servidor. Não contém credenciais reais.
# Guia: INSTALACAO_SERVIDOR.md. Preserve este arquivo como exemplo.
# Gere uma senha longa apenas com letras e números (ex.: openssl rand -hex 32).
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_ALEATORIA
POSTGRES_DATA_PATH=/etc/docker/appb2t/dados/postgres_data
APP_NETWORK_NAME=appb2t_network
APP_PORT=1992
APP_BIND=0.0.0.0
APP_URL=https://somosb2t.com.br
# No ambiente local: APP_PORT=3000, APP_BIND=127.0.0.1,
# APP_URL=http://localhost:3000 e POSTGRES_DATA_PATH=postgres_data.
# Sem POSTGRES_DATA_PATH, o Compose mantém o volume nomeado legado.
# C4: gere 32 bytes aleatórios em hexadecimal; necessário para emitir links de arte.
# Preserve a chave em local protegido. Não é uma senha de usuário.
ART_ACCESS_KEY=
# C5: outra chave de 32 bytes hex, exclusiva dos links privados de checkout.
CHECKOUT_ACCESS_KEY=
# Desenvolvimento local: ajuste host e porta do seu PostgreSQL.
# O Compose monta DATABASE_URL com o hostname interno db automaticamente.
DATABASE_URL=postgresql://b2t:SUBSTITUA_POR_UMA_SENHA_ALEATORIA@localhost:5432/b2t
