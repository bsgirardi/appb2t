# Gere uma senha longa apenas com letras e números (ex.: 32 bytes hex).
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_ALEATORIA
APP_PORT=3000
APP_BIND=127.0.0.1
# Em produção externa: https://appb2t.seudominio.com.br
APP_URL=http://localhost:3000
# Desenvolvimento local: ajuste host e porta do seu PostgreSQL.
# O Compose monta DATABASE_URL com o hostname interno db automaticamente.
DATABASE_URL=postgresql://b2t:SUBSTITUA_POR_UMA_SENHA_ALEATORIA@localhost:5432/b2t
